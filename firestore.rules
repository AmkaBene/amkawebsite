rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'amkabene@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidVisitorNote(data) {
      return data.keys().hasAll(['authorName', 'message', 'sticker', 'isPublic', 'createdAt'])
        && data.keys().hasOnly(['authorName', 'message', 'sticker', 'isPublic', 'createdAt'])
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 40
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 280
        && data.sticker is string
        && data.sticker in ['star', 'bubble', 'disc', 'fish', 'heart', 'spark']
        && data.isPublic is bool
        && data.isPublic == true
        && data.createdAt == request.time;
    }

    match /visitor_notes/{noteId} {
      allow get: if isValidId(noteId) && existing().isPublic == true;
      allow list: if existing().isPublic == true;
      allow create: if isValidId(noteId) && isValidVisitorNote(incoming());
      allow update: if false;
      allow delete: if isValidId(noteId) && isAdmin();
    }
  }
}
